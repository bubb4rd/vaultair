{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Everything the main window may call. Keep this list minimal; see docs/adr/0001-stack.md.",
  "windows": [
    "main"
  ],
  "local": true,
  "permissions": [
    "core:event:default",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-unminimize",
    "core:window:allow-is-maximized",
    "core:window:allow-internal-toggle-maximize",
    "allow-app-info",
    "allow-vault-kdf-calibrate",
    "allow-vault-create",
    "allow-vault-unlock",
    "allow-vault-lock",
    "allow-vault-status",
    "allow-vault-integrity-check",
    "allow-vault-create-demo",
    "allow-vault-location-check",
    "allow-vault-pick-folder",
    "allow-recent-vaults-list",
    "allow-recent-vaults-forget",
    "allow-strength-estimate"
  ]
}
