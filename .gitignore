# Build output
/target/
**/target/
node_modules/
dist/
src-tauri/gen/schemas/

# Vault data: never commit a vault, header, or backup (including test runs)
*.vdb
*.vdb-journal
*.vdb-wal
*.vdb-shm
*.vhdr
*.vhdr.prev
*.vhdr.tmp
*.vaultair-backup

# Logs and local env
*.log
.env
.env.*
!.env.example

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
Desktop.ini
.DS_Store

# Claude Code local-only settings
.claude/settings.local.json

# Third-party agent skills: local design tooling, not part of the app
.claude/skills/
.agents/
skills-lock.json

# Internal planning docs, kept locally
docs/implementation-plan.md
docs/phase-notes.md
docs/spikes/

# Logo review scratch: contact sheet and candidate files (docs/logo-pipeline.md)
.asset-work/

# Local video work, not part of the app
/videos/

# Python bytecode (ui-ux-pro-max scripts)
__pycache__/

# Golden fixture vaults and backups (test-only password, see crates/vaultair-core/tests/golden.rs) are the one exception.
!tests-fixtures/**/vault.vdb
!tests-fixtures/**/vault.vhdr
!tests-fixtures/**/*.vaultair-backup
tests-fixtures/**/.lock
